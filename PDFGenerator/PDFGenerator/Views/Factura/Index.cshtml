
@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container my-5">
    <div class="card shadow-lg">

        <div class="card-header bg-primary text-white">
            <h3 class="mb-0">Factura</h3>
        </div>
        <div class="card-body">
            <div id="alertContainer"></div>

        <!--Formulario de Cliente -->
            <form id="formCliente">
                <div class="row g-3">
                    <div class="col-md-4">
                        <label for="idID" class="form-label">ID
                            <a href="#" data-bs-toggle="modal" data-bs-target="#clienteModal">ID</a>
                        </label>
                        <input class="form-control" id="idID" enable="false" placeholder="ID" />
                    </div>
                    <div class="col-md-4">
                        <label for="idNombre" class="form-label">Nombre</label>
                        <input class="form-control" id="idNombre" placeholder="Nombres" />
                    </div>
                    <div class="col-md-4">
                        <label for="idDireccion" class="form-label">Direccion</label>
                        <input class="form-control" id="idDireccion" placeholder="Direccion" />
                    </div>
                    <div class="col-md-4">
                        <label for="idTelefono" class="form-label">Telefono</label>
                        <input class="form-control" id="idTelefono" placeholder="Telefono" />
                    </div>
                    <div class="col-md-4">
                        <label for="idCorreo" class="form-label">Correo</label>
                        <input class="form-control" id="idCorreo" placeholder="email@example.com" />
                    </div>
                </div>
            </form>

        </div>
    </div>

</div>

<!--Modeal de Cliente -->

