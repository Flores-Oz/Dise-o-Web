
@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container">
    <div class="row">
        <div class="col-12 mb-2">
            <input class="form-control" id="inCodigo" />
        </div>
        <div class="col-4 mb-2">
            <input class="form-control" id="innombre" />
        </div>
        <div class="col-3 mb-2">
            <input class="form-control" id="inprecioCosto" />
        </div>
        <div class="col-3 mb-2">
            <input class="form-control" id="inprecioVenta" />
        </div>
        <div class="col-3 mb-2">
            <input class="form-control" id="inExistencia" />
        </div>
        <div class="col-6 mb-2">
            <select class="form-select" id="selecMarca"></select>
        </div>
        <div class="col-6 mb-2">
            <select class="form-select" id="selecModelo"></select>
        </div>
        <div class="col-12 mb-2">
            <button class="btn btn-success" id="btnAgregar">Agregar</button>
        </div>
    </div>

    <div>
        <table class="table">
            <thead>
                <tr>
                    <th>Codigo</th>
                    <th>Nombre</th>
                    <th>Marca</th>
                    <th>Precio Costo</th>
                    <th>Precio Venta</th>
                    <th>Existencia</th>
                    <th></th>
                </tr>
            </thead>
            <tbody id="tbproductos"></tbody>
        </table>
    </div>

</div>



<script type="text/javascript" src="~/js/producto/producto.js"></script> 